#!/usr/bin/env bash
# Kommando der Agenten: Zugriff auf Kontext, eigene Identität und andere Lead-Agenten.
# Läuft nur innerhalb eines Laufs, den der Leitstand gestartet hat.
set -euo pipefail

if [ -z "${LEITSTAND_URL:-}" ] || [ -z "${LEITSTAND_RUN:-}" ]; then
  echo "leitstand: läuft nur innerhalb eines Agentenlaufs des Leitstands" >&2
  exit 2
fi

# leitstand auftrag TITEL [modell=…] [aufwand=…]: Text über stdin
order() {
  local title="$1"; shift
  local fields=(--data-urlencode "titel=$title")
  for pair in "$@"; do
    case "$pair" in
      modell=* | model=* | aufwand=* | effort=*) fields+=(--data-urlencode "$pair") ;;
      *) echo "leitstand auftrag: unbekannte Angabe „$pair“ (erlaubt: modell=…, aufwand=…)" >&2; exit 2 ;;
    esac
  done
  call auftrag "${fields[@]}" --data-urlencode "text@-"
}

call() {
  local path="$1"
  shift
  curl -sS --max-time 90 -H "Authorization: Bearer $LEITSTAND_RUN" "$@" "$LEITSTAND_URL/agent/$path"
  echo
}

usage() {
  cat >&2 <<'EOF'
leitstand wer
leitstand kontext liste | lesen NAME | schreiben NAME   (Inhalt über stdin)
leitstand mail liste | lesen ID | codes | senden AN BETREFF   (Text über stdin)
leitstand sms liste
leitstand pay anfragen BETRAG WÄHRUNG HÄNDLER GRUND | abrufen ID
leitstand abo liste | beendet NAME
leitstand abo setzen NAME [kosten=4] [waehrung=EUR] [intervall=monat|jahr|woche|einmalig]
                          [bis=JJJJ-MM-TT] [verlaengert=ja|nein] [kuendigen=TEXT] [zweck=TEXT] [zugang=TRESORNAME]
leitstand tresor liste | zeigen NAME | code NAME
leitstand tresor neu NAME [BENUTZER] [ADRESSE]        (erzeugt ein Passwort)
leitstand tresor setzen NAME [BENUTZER] [ADRESSE]     (Passwort über stdin)
leitstand tresor 2fa NAME | notiz NAME                (Wert über stdin; 2fa mit leerer Eingabe entfernt den Schlüssel)
leitstand tresor loeschen NAME                        (fremde Einträge erst nach Freigabe durch den Menschen)
leitstand tell PROJEKTNAME NACHRICHT
leitstand laeufe | laeufe weiter IDS|alle | laeufe erledigt IDS|alle   (vom Menschen gestoppte Läufe, nur auf seine Anweisung)
leitstand auftrag TITEL [modell=opus|sonnet|haiku|fable] [aufwand=low|medium|high|xhigh|max]
                                                      (Auftragstext über stdin; Vorgabe: opus, medium)
leitstand auftraege modell IDS|alle [modell=…] [aufwand=…]   (Modell eigener Teilaufträge ab ihrem nächsten Zug)
leitstand auftraege | auftraege stopp IDS|alle | auftraege weiter IDS|alle
leitstand auftraege entfernen IDS|alle                (beendete Teilaufträge aus der Liste entfernen)
leitstand auftraege pause IDS|alle [bis=reset|HH:MM|MINUTEN]   (eigene Teilaufträge anhalten)
leitstand budget                                      (Abo-Kontingent: Auslastung, Rücksetzzeit, Empfehlung)
leitstand laptop TITEL                                (Auftrag an den Mac des Menschen, Text über stdin)
leitstand projekte                                    (Projekte mit ihren letzten Chats)
leitstand weitergeben PROJEKT TITEL | nachreichen CHATID | verteilt   (nur Zentrale, Text über stdin)
leitstand lesen CHATID [ANZAHL] | suchen BEGRIFF      (nur Zentrale: Gesamtkontext bei Bedarf)
leitstand hilfe TEXT | hilfe erledigt                 (Klick im Livebild deines Browsers)
leitstand uebergabe URL TEXT                          (Mensch erledigt es im eigenen Browser)
leitstand stand TEXT                                  (Zwischenstand bei langen Schritten)
leitstand ergebnis TITEL ZIEL [BESCHREIBUNG]           (ZIEL: Pfad im Projektordner oder Webadresse)
EOF
  exit 2
}

case "${1:-}:${2:-}" in
  wer:*) call wer ;;
  kontext:liste | kontext:) call kontext ;;
  kontext:lesen) call kontext/lesen -G --data-urlencode "name=${3:?NAME fehlt}" ;;
  kontext:schreiben) call kontext/schreiben --data-urlencode "name=${3:?NAME fehlt}" --data-urlencode "text@-" ;;
  mail:liste | mail:) call mail ;;
  mail:lesen) call mail/lesen -G --data-urlencode "id=${3:?ID fehlt}" ;;
  mail:codes) call mail/codes ;;
  mail:senden) call mail/senden --data-urlencode "an=${3:?AN fehlt}" --data-urlencode "betreff=${4:?BETREFF fehlt}" --data-urlencode "text@-" ;;
  sms:liste | sms:) call sms ;;
  pay:anfragen) call pay/anfragen --data-urlencode "betrag=${3:?BETRAG fehlt}" --data-urlencode "waehrung=${4:?WÄHRUNG fehlt}" --data-urlencode "haendler=${5:?HÄNDLER fehlt}" --data-urlencode "grund=${6:?GRUND fehlt}" ;;
  pay:abrufen) call pay/abrufen -G --data-urlencode "id=${3:?ID fehlt}" ;;
  abo:liste | abo:) call abo ;;
  abo:beendet) call abo/beendet --data-urlencode "name=${3:?NAME fehlt}" ;;
  abo:setzen)
    name="${3:?NAME fehlt}"
    shift 3
    fields=(--data-urlencode "name=$name")
    for pair in "$@"; do fields+=(--data-urlencode "$pair"); done
    call abo/setzen "${fields[@]}"
    ;;
  tresor:liste | tresor:) call tresor ;;
  tresor:zeigen) call tresor/zeigen -G --data-urlencode "name=${3:?NAME fehlt}" ;;
  tresor:lesen) call tresor/lesen -G --data-urlencode "name=${3:?NAME fehlt}" ;;
  tresor:code) call tresor/code -G --data-urlencode "name=${3:?NAME fehlt}" ;;
  tresor:neu) call tresor/neu --data-urlencode "name=${3:?NAME fehlt}" --data-urlencode "benutzer=${4:-}" --data-urlencode "url=${5:-}" ;;
  tresor:setzen) call tresor/setzen --data-urlencode "name=${3:?NAME fehlt}" --data-urlencode "benutzer=${4:-}" --data-urlencode "url=${5:-}" --data-urlencode "wert@-" ;;
  tresor:2fa) call tresor/2fa --data-urlencode "name=${3:?NAME fehlt}" --data-urlencode "wert@-" ;;
  tresor:loeschen) call tresor/loeschen --data-urlencode "name=${3:?NAME fehlt}" ;;
  tresor:notiz) call tresor/notiz --data-urlencode "name=${3:?NAME fehlt}" --data-urlencode "wert@-" ;;
  auftrag:stopp | auftrag:pause | auftrag:weiter | auftrag:entfernen)
    if [ -n "${3:-}" ] && [[ "$3" != *=* ]]; then a="$2"; shift 2; call "auftraege/$a" --data-urlencode "ids=$*"
    else shift; order "$@"; fi ;;
  auftraege:modell)
    shift 2
    ids=(); fields=()
    for w in "$@"; do case "$w" in *=*) fields+=(--data-urlencode "$w") ;; *) ids+=("$w") ;; esac; done
    call auftraege/modell --data-urlencode "ids=${ids[*]:?IDS oder alle fehlt}" "${fields[@]}" ;;
  auftraege:stopp | auftraege:pause | auftraege:weiter | auftraege:entfernen) a="$2"; shift 2; call "auftraege/$a" --data-urlencode "ids=${*:?IDS oder alle fehlt}" ;;
  budget:*) call budget ;;
  auftrag:*) shift; [ -n "${1:-}" ] || { echo "TITEL fehlt" >&2; exit 2; }; order "$@" ;;
  auftraege:*) call auftraege ;;
  projekte:*) call projekte ;;
  weitergeben:*) call weitergeben --data-urlencode "projekt=${2:?PROJEKT fehlt}" --data-urlencode "titel=${3:?TITEL fehlt}" --data-urlencode "text@-" ;;
  nachreichen:*) call nachreichen --data-urlencode "chat=${2:?CHATID fehlt}" --data-urlencode "text@-" ;;
  verteilt:*) call verteilt ;;
  lesen:*) call lesen --data-urlencode "chat=${2:?CHATID fehlt}" --data-urlencode "anzahl=${3:-}" ;;
  suchen:*) shift; call suchen --data-urlencode "begriff=${*:?BEGRIFF fehlt}" ;;
  laptop:*) call laptop --data-urlencode "titel=${2:?TITEL fehlt}" --data-urlencode "text@-" ;;
  ergebnis:*) call ergebnis --data-urlencode "titel=${2:?TITEL fehlt}" --data-urlencode "ziel=${3:?ZIEL fehlt}" --data-urlencode "text=${4:-}" ;;
  stand:*) call stand --data-urlencode "text=${2:?TEXT fehlt}" ;;
  hilfe:*) call hilfe --data-urlencode "text=${2:?TEXT fehlt}" ;;
  uebergabe:*) call uebergabe --data-urlencode "url=${2:?URL fehlt}" --data-urlencode "text=${3:?TEXT fehlt}" ;;
  laeufe:liste | laeufe:) call laeufe ;;
  laeufe:weiter) shift 2; call laeufe/weiter --data-urlencode "ids=${*:?IDS oder alle fehlt}" ;;
  laeufe:erledigt) shift 2; call laeufe/erledigt --data-urlencode "ids=${*:?IDS oder alle fehlt}" ;;
  tell:*) call tell --data-urlencode "projekt=${2:?PROJEKTNAME fehlt}" --data-urlencode "nachricht=${3:?NACHRICHT fehlt}" ;;
  *) usage ;;
esac
